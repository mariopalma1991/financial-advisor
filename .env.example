# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Direct Postgres connection (migrations only; queries use REST API)
# Use the Session Pooler for GitHub Actions compatibility (IPv4):
#   Project Settings -> Database -> Connection Pooling -> Session mode
# Copy the pooler string (port 5432, host aws-1-ca-central-1.pooler.supabase.co)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-1-ca-central-1.pooler.supabase.com:5432/postgres

# --- Optional: Slack notifications for pipeline runs ---
# Create a Slack app -> Incoming Webhooks -> copy the webhook URL
# You'll get job started/completed summaries + error alerts
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Optional: SEC EDGAR User-Agent (required by SEC policy) ---
# Format: "Organization/Version (contact@email.com)"
# The SEC requires a real email address; filings are DISABLED until this is set.
# Set this in GitHub: Settings -> Secrets and variables -> Actions -> Variables
# Then uncomment the cron schedule in .github/workflows/ingest_filings.yml
# EDGAR_USER_AGENT=financial-advisor/1.0 (your-real-email@domain.com)

# --- Finnhub (News & Fundamentals) ---
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Phase 2 (not needed for Phase 1) ---
# QDRANT_URL=
# QDRANT_API_KEY=
