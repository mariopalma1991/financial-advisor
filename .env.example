# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Direct Postgres connection (migrations only; queries use REST API)
# Use the Session Pooler for GitHub Actions compatibility (IPv4):
#   Project Settings -> Database -> Connection Pooling -> Session mode
# Copy the pooler string (port 5432, host aws-1-ca-central-1.pooler.supabase.co)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-1-ca-central-1.pooler.supabase.com:5432/postgres

# --- Optional: quality alert webhook (Telegram / Discord / Slack) ---
ALERT_WEBHOOK_URL=

# --- Phase 2 (not needed for Phase 1) ---
# QDRANT_URL=
# QDRANT_API_KEY=
